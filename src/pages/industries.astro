    services: [
      "Mechanical Erection",
      "Process & Plant Piping",
      "Electrical & Instrumentation",
      "Civil & Structural Works",
      "Pre-Commissioning & Commissioning",
      "Maintenance Support"
    ],
    products: [
      "Industrial RO Systems",
      "Sewage Treatment Plants",
      "Water Filtration Systems",
      "Industrial Valves",
      "Flow Transmitters",
      "Flushing Units",
      "HVAC Equipment",
      "Industrial Automation Systems"
    ],
    applications: [
      "Reverse osmosis water treatment",
      "Sewage and wastewater treatment",
      "Water distribution and piping systems",
      "Flow measurement and monitoring",
      "Pump and mechanical equipment installation",
      "Process automation and control"
    ]
  },
  {
    id: "ind-infra",
    num: "06",
    name: "Infrastructure & Construction",
    tagline: "Industrial Construction, Mechanical Works & Infrastructure Support",
    img: "https://images.unsplash.com/photo-1590674899484-d5640e854abe?auto=format&fit=crop&w=1200&q=85",
    desc: "Infrastructure and construction projects involve coordinated civil, structural, mechanical, electrical and utility-related activities. Petrastream aims to support relevant project requirements through its contracting services and specialized product supply capabilities.",
    services: [
      "Civil & Structural Works",
      "Mechanical Erection",
      "Electrical & Instrumentation",
      "Process & Plant Piping",
      "Industrial Construction",
      "Pre-Commissioning & Commissioning"
    ],
    products: [
      "Specialized Containers",
      "Modular Buildings",
      "HVAC Systems",
      "Industrial Valves",
      "Flange Management Tools",
      "Industrial Automation",
      "RO & STP Systems",
      "Electrical Houses and Technical Buildings"
    ],
    applications: [
      "Industrial facility construction",
