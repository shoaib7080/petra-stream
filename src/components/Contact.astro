---
// Contact.astro - Section 10: Business Enquiry & Contact Section
import { siteConfig } from '../config/siteConfig.js';
---

<section class="section-block section-white contact-section" id="contact">
  <div class="content-frame">
    <div class="contact-two-col-grid">
      <!-- Left Column: Contact Details & Placeholders -->
      <div class="contact-info-column">
        <!-- <div class="section-label-chip">
         <span class="label-dot"></span> 
          <span>GET IN TOUCH</span>
        </div> -->
        <h2 class="section-h2" style="margin-top: 0.75rem;">Direct Business Enquiry & Technical Consultation</h2>
        <p class="section-lead-p" style="margin-bottom: 2rem;">
          Connect with our engineering desk and specialized product specialists in the UAE. Whether planning an upcoming plant turnaround, sourcing critical mechanical components, or requesting an engineering proposal, we are ready to assist.
        </p>

        <div class="contact-card-list">
          <!-- Location Placeholder -->
          <div class="contact-meta-card">
            <div class="contact-icon-box">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <span class="contact-meta-label">Corporate Location (UAE)</span>
              <p class="contact-meta-val">{siteConfig.contact.addressPlaceholder}</p>
            </div>
          </div>

          <!-- Email Placeholder -->
          <div class="contact-meta-card">
            <div class="contact-icon-box">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <span class="contact-meta-label">Technical RFQ & Enquiries</span>
              <p class="contact-meta-val"><a href={`mailto:${siteConfig.contact.emailPlaceholder}`} class="contact-meta-link">{siteConfig.contact.emailPlaceholder}</a></p>
            </div>
          </div>

          <!-- Phone Placeholder -->
          <div class="contact-meta-card">
            <div class="contact-icon-box">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <span class="contact-meta-label">Direct Phone Line</span>
              <p class="contact-meta-val">{siteConfig.contact.phonePlaceholder}</p>
            </div>
          </div>

          <!-- Working Hours -->
          <div class="contact-meta-card">
            <div class="contact-icon-box">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <span class="contact-meta-label">Business Hours (UAE)</span>
              <p class="contact-meta-val">{siteConfig.contact.workingHours}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean B2B Enquiry Form -->
      <div class="contact-form-column">
        <div class="contact-form-wrapper">
          <div class="form-header-box">
            <h3 class="form-title-h3">Submit Project Enquiry / RFQ</h3>
            <p class="form-sub-p">Complete the form below to receive a direct response from our technical engineering desk.</p>
          </div>

          <form class="b2b-enquiry-form" onsubmit="event.preventDefault(); alert('Thank you for your enquiry. Our engineering desk will review your requirements and respond shortly.');">
            <div class="form-row-duo">
              <div class="form-field-group">
                <label class="field-label-bold" for="contact-name">Full Name *</label>
                <input type="text" id="contact-name" class="input-box" placeholder="e.g. Tariq Al-Mansoor" required />
              </div>
              <div class="form-field-group">
                <label class="field-label-bold" for="contact-company">Company / Organization *</label>
                <input type="text" id="contact-company" class="input-box" placeholder="e.g. National Petroleum LLC" required />
              </div>
            </div>

            <div class="form-row-duo">
              <div class="form-field-group">
                <label class="field-label-bold" for="contact-email">Corporate Email *</label>
                <input type="email" id="contact-email" class="input-box" placeholder="name@company.com" required />
              </div>
              <div class="form-field-group">
                <label class="field-label-bold" for="contact-phone">Phone / WhatsApp Number</label>
                <input type="tel" id="contact-phone" class="input-box" placeholder="+971 50 000 0000" />
              </div>
            </div>

            <div class="form-field-group">
              <label class="field-label-bold" for="contact-category">Requirement Category *</label>
              <select id="contact-category" class="input-box" required style="cursor: pointer;">
                <option value="" disabled selected>Select Requirement Category...</option>
                <option value="Mechanical Services">Mechanical Services & Contracting</option>
                <option value="Mechanical Products">Mechanical Products & Valves Supply</option>
                <option value="Shutdown & Turnaround">Plant Maintenance & Turnaround Support</option>
                <option value="Piping & Pipeline">Process Piping & Pipeline Works</option>
                <option value="General Partnership">General B2B Industrial Partnership</option>
              </select>
            </div>

            <div class="form-field-group">
              <label class="field-label-bold" for="contact-message">Project Scope / Technical Specifications *</label>
              <textarea id="contact-message" class="input-box" rows="4" placeholder="Please outline your operating parameters, timeline, bill of quantities, or specific engineering requirements..." required></textarea>
            </div>

            <button type="submit" class="btn-orange-solid" style="width: 100%; justify-content: center; padding: 1rem 1.75rem; font-size: 1.05rem;">
              <span>Submit Business Enquiry</span>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>

            <p style="font-size: 0.85rem; color: var(--slate-muted); margin-top: 1rem; line-height: 1.5; text-align: center;">
              We respect engineering confidentiality. All technical documents and project scopes are handled under strict NDA protocols.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

