---
// CTA.astro - Section 10: Let's Work Together / Main CTA per blueprint
import { siteConfig } from '../config/siteConfig.js';
---

<section class="section-block theme-dark cta-section" id="partnership">
  <div class="content-frame">
    <div class="cta-inner-card">
      <div class="cta-content-col">
        <div class="section-label-chip-light">
          <span class="label-dot-orange"></span>
          <span>LET'S CONNECT</span>
        </div>
        <h2 class="cta-h2">Looking for the Right Industrial Solution?</h2>
        <p class="cta-lead-p">
          Whether you require industrial contracting services or specialized equipment, Petrastream is ready to understand your requirements and discuss suitable solutions.
        </p>

        <!-- CTAs per blueprint -->
        <div class="cta-button-cluster">
          <a href="/contact-us" class="btn-orange-solid">
            <span>Request an Enquiry →</span>
          </a>
          <a href="/contact-us" class="btn-white-ghost">
            <span>Contact Us →</span>
          </a>
        </div>
      </div>

      <!-- Quick Contact Info Pill Box -->
      <div class="cta-contact-box">
        <h3 class="cta-box-title">Direct Engineering Desk</h3>
        <p class="cta-box-sub">Our technical sales engineers respond to all B2B inquiries within 24 business hours.</p>

        <div class="cta-info-list">
          <div class="cta-info-row">
            <div class="cta-icon-circle">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <span class="cta-info-label">Direct Email</span>
              <a href={`mailto:${siteConfig.contact.emailPlaceholder}`} class="cta-info-val">{siteConfig.contact.emailPlaceholder}</a>
            </div>
          </div>

          <div class="cta-info-row">
            <div class="cta-icon-circle">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <span class="cta-info-label">UAE Direct Phone</span>
              <span class="cta-info-val">{siteConfig.contact.phonePlaceholder}</span>
            </div>
          </div>

          <div class="cta-info-row">
            <div class="cta-icon-circle">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
            </div>
            <div>
              <span class="cta-info-label">Strategic Headquarters</span>
              <span class="cta-info-val">{siteConfig.country} (Abu Dhabi / Dubai)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
