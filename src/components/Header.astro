---
// Header.astro - Corporate Navigation with Multipage Routes & Mega-Menus
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="main-header corporate-header">
  <div class="content-frame">
    <div class="header-row">
      <!-- Petrastream Company Logo (Left Aligned) -->
      <a href="/" class="header-brand">
        <div class="brand-badge-box">P</div>
        <div class="brand-naming">
          <span class="brand-title-white">PETRASTREAM</span>
          <span class="brand-subline-orange">CONTRACTING LLC</span>
        </div>
      </a>

      <!-- Right Aligned Navigation Menu with Dropdown Mega-Menus -->
      <nav aria-label="Main Navigation">
        <ul class="bold-nav-list">
          <li>
            <a href="/" class={`nav-link-item ${activePage === 'home' ? 'active' : ''}`}>Home</a>
          </li>
          
          <li>
            <a href="/about-us" class={`nav-link-item ${activePage === 'about' ? 'active' : ''}`}>About Us</a>
          </li>
          
          <!-- Services Dropdown (3-Column Mega-Menu) -->
          <li class="nav-dropdown-wrap">
            <a href="/services" class={`nav-link-item ${activePage === 'services' ? 'active' : ''}`}>
              <span>Services</span>
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-left:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div class="dropdown-flyout mega-3col">
              <div class="mega-col">
                <span class="mega-heading">Operations & Maintenance</span>
                <a href="/services/maintenance-shutdown-turnaround" class="flyout-item">01. Maintenance & Turnaround</a>
                <a href="/services/pre-commissioning-commissioning" class="flyout-item">02. Pre-Commissioning & Startup</a>
                <a href="/services/electrical-instrumentation" class="flyout-item">03. Electrical & Instrumentation</a>
              </div>
              <div class="mega-col">
                <span class="mega-heading">Mechanical & Piping</span>
                <a href="/services/civil-structural-works" class="flyout-item">04. Civil & Structural Works</a>
                <a href="/services/mechanical-erection" class="flyout-item">05. Mechanical Equipment Erection</a>
                <a href="/services/process-plant-piping" class="flyout-item">06. Process & Plant Piping</a>
              </div>
              <div class="mega-col">
                <span class="mega-heading">Construction & Safety</span>
                <a href="/services/pipeline-construction" class="flyout-item">07. Pipeline Construction</a>
                <a href="/services/oil-gas-plant-construction" class="flyout-item">08. Oil & Gas Plant Construction</a>
                <a href="/services/welding-habitats" class="flyout-item">09. Welding Habitat Solutions</a>
              </div>
              <div style="grid-column: 1 / -1; padding-top: 0.75rem; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
                <a href="/services" style="color: var(--orange); font-weight: 700; font-size: 0.92rem; text-decoration: none;">View All 9 Services Overview →</a>
              </div>
            </div>
          </li>

          <!-- Products Dropdown (6-Category Mega-Menu) -->
          <li class="nav-dropdown-wrap">
            <a href="/products" class={`nav-link-item ${activePage === 'products' ? 'active' : ''}`}>
              <span>Products</span>
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-left:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div class="dropdown-flyout mega-3col">
              <div class="mega-col">
                <span class="mega-heading">Process & Piping</span>
                <a href="/products/hot-tapping-equipment" class="flyout-item">01. Hot Tapping Equipment</a>
                <a href="/products/industrial-flushing-units" class="flyout-item">02. Industrial Flushing Units</a>
                <a href="/products/hydro-jetting-equipment" class="flyout-item">03. Hydro-Jetting Packages</a>
                <a href="/products/industrial-valves" class="flyout-item">04. Industrial Valves & Actuators</a>
                <a href="/products/orifice-flanges-plates" class="flyout-item">05. Orifice Flanges & Plates</a>
                <a href="/products/flange-management-bolting-tools" class="flyout-item">06. Flange & Bolting Tools</a>
              </div>
              <div class="mega-col">
                <span class="mega-heading">Monitoring & Safety</span>
                <a href="/products/flow-transmitters" class="flyout-item">07. Flow Transmitters</a>
                <a href="/products/wireless-corrosion-sensors" class="flyout-item">08. Wireless Corrosion Sensors</a>
                <a href="/products/fire-tarpaulin-welding-blankets" class="flyout-item">09. Fire Tarpaulins & Blankets</a>
                <a href="/products/pressurised-welding-habitat" class="flyout-item">10. Pressurised Habitats</a>
                <a href="/products/hvac-systems-equipment" class="flyout-item">11. HVAC & Chiller Systems</a>
                <a href="/products/blast-resistant-buildings-ehouses" class="flyout-item">12. Blast-Proof E-Houses</a>
              </div>
              <div class="mega-col">
                <span class="mega-heading">Modular & Automation</span>
                <a href="/products/specialized-containers-accommodation" class="flyout-item">13. Specialized Containers</a>
                <a href="/products/cosasco-fittings-accessories" class="flyout-item">14. COSASCO Access Fittings</a>
                <a href="/products/ro-stp-water-treatment" class="flyout-item">15. RO & STP Water Treatment</a>
                <a href="/products/robotics-solutions" class="flyout-item">16. Robotics Solutions</a>
                <a href="/products/industrial-automation-solutions" class="flyout-item">17. Industrial Automation</a>
              </div>
              <div style="grid-column: 1 / -1; padding-top: 0.75rem; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
                <a href="/products" style="color: var(--orange); font-weight: 700; font-size: 0.92rem; text-decoration: none;">View All 17 Products Catalogue →</a>
              </div>
            </div>
          </li>

          <!-- Industries We Serve Dropdown -->
          <li class="nav-dropdown-wrap">
            <a href="/industries" class={`nav-link-item ${activePage === 'industries' ? 'active' : ''}`}>
              <span>Industries We Serve</span>
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="margin-left:4px;"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div class="dropdown-flyout mega-2col">
              <div class="mega-col">
                <a href="/industries#ind-oilgas" class="flyout-item">Oil & Gas (Upstream / Downstream)</a>
                <a href="/industries#ind-petrochem" class="flyout-item">Petrochemical & Refining</a>
                <a href="/industries#ind-energy" class="flyout-item">Energy & Power Generation</a>
              </div>
              <div class="mega-col">
                <a href="/industries#ind-mfg" class="flyout-item">Industrial Manufacturing</a>
                <a href="/industries#ind-water" class="flyout-item">Water Treatment & Utilities</a>
                <a href="/industries#ind-infra" class="flyout-item">Infrastructure & Heavy Construction</a>
              </div>
              <div style="grid-column: 1 / -1; padding-top: 0.75rem; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
                <a href="/industries" style="color: var(--orange); font-weight: 700; font-size: 0.92rem; text-decoration: none;">View All Supported Industries →</a>
              </div>
            </div>
          </li>

          <li>
            <a href="/contact-us" class={`nav-link-item ${activePage === 'contact' ? 'active' : ''}`}>Contact Us</a>
          </li>
        </ul>
      </nav>

      <!-- Actions: Brochure Download & Get in Touch CTA -->
      <div class="header-cta-group">
        <!-- Brochure Download Button -->
        <a 
          href="#brochure" 
          onclick="alert('Petrastream Technical Brochure & Company Profile PDF will be available for download once the official document is uploaded.'); return false;" 
          class="btn-brochure-nav" 
          title="Download Company Brochure (PDF)"
        >
          <span>Brochure</span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </a>

        <!-- Orange Get in Touch Button -->
        <a href="/contact-us" class="btn-orange-solid">
          <span>Get in Touch</span>
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>

        <!-- Mobile Menu Trigger -->
        <button type="button" class="mobile-hamburger" aria-label="Toggle Mobile Menu">
          <svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-nav-panel" class="mobile-nav-backdrop" style="display:none; opacity:0; position:fixed; inset:0; background:rgba(9,21,35,0.92); z-index:2000; transition:opacity 0.2s ease;">
  <div class="mobile-nav-drawer-body" style="position:absolute; top:0; right:0; width:min(320px, 86vw); max-width:100%; height:100%; background:var(--navy); padding:clamp(1.25rem, 4vw, 2rem); display:flex; flex-direction:column; gap:1.25rem; border-left:2px solid var(--orange); box-shadow:-8px 0 30px rgba(0,0,0,0.5); overflow-y:auto; box-sizing:border-box;">
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.15); padding-bottom:1.25rem;">
      <span style="font-family:'Manrope',sans-serif; font-weight:700; color:var(--white); font-size:1.25rem;">PETRASTREAM</span>
      <button id="mobile-nav-close-btn" style="font-size:1.6rem; color:var(--orange); padding:0.25rem; background:none; border:none; cursor:pointer;" aria-label="Close Mobile Menu">✕</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:1rem; font-weight:600; font-size:1.05rem;">
      <a href="/" class="mobile-drawer-anchor" style={activePage === 'home' ? "color:var(--orange);" : "color:var(--white);"}>Home</a>
      <a href="/about-us" class="mobile-drawer-anchor" style={activePage === 'about' ? "color:var(--orange);" : "color:var(--white);"}>About Us</a>
      <a href="/services" class="mobile-drawer-anchor" style={activePage === 'services' ? "color:var(--orange);" : "color:var(--white);"}>Services (9)</a>
      <a href="/products" class="mobile-drawer-anchor" style={activePage === 'products' ? "color:var(--orange);" : "color:var(--white);"}>Products (17)</a>
      <a href="/industries" class="mobile-drawer-anchor" style={activePage === 'industries' ? "color:var(--orange);" : "color:var(--white);"}>Industries We Serve</a>
      <a href="/contact-us" class="mobile-drawer-anchor" style={activePage === 'contact' ? "color:var(--orange);" : "color:var(--white);"}>Contact Us</a>
    </div>
    <div style="margin-top:auto; display:flex; flex-direction:column; gap:0.75rem; padding-top:1.5rem; border-top:1px solid rgba(255,255,255,0.15);">
      <a 
        href="#brochure" 
        onclick="alert('Petrastream Technical Brochure & Company Profile PDF will be available for download once the official document is uploaded.'); return false;" 
        class="btn-brochure-nav mobile-drawer-anchor" 
        style="width:100%; text-align:center; justify-content:center;"
      >
        <span>Download Brochure ↓</span>
      </a>
      <a href="/contact-us" class="btn-orange-solid mobile-drawer-anchor" style="width:100%; text-align:center; justify-content:center;">Get in Touch</a>
    </div>
  </div>
</div>
