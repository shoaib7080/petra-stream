---
// src/pages/industries/[slug].astro - Dedicated Individual Industry Sector Subpage
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Modals from '../../components/Modals.astro';
import { industriesData } from '../../data/industriesData.js';

export function getStaticPaths() {
  return industriesData.map((industry, index) => {
    const prevIndustry = index > 0 ? industriesData[index - 1] : industriesData[industriesData.length - 1];
    const nextIndustry = index < industriesData.length - 1 ? industriesData[index + 1] : industriesData[0];
    return {
      params: { slug: industry.slug },
      props: { industry, prevIndustry, nextIndustry }
    };
  });
}

const { industry, prevIndustry, nextIndustry } = Astro.props;
---

<Layout 
  title={`${industry.name} | Petrastream Contracting LLC UAE`}
  description={`${industry.name} specialized mechanical services and industrial product solutions in the UAE. ${industry.desc.slice(0, 155)}...`}
  canonical={`https://petrastream.ae/industries/${industry.slug}`}
>
  <Header activePage="industries" />

  <main>
    <!-- Section 1: Hero Banner -->
    <section class="subpage-hero">
      <div class="subpage-hero-bg" style={`background-image: url('${industry.img}');`}></div>
      <div class="subpage-hero-scrim"></div>
      <div class="content-frame">
        <div class="subpage-hero-content">
          <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/industries">Industries We Serve</a>
            <span aria-hidden="true">/</span>
            <span>{industry.name}</span>
          </nav>
          <div class="section-kicker-light">INDUSTRY SECTOR • B2B MECHANICAL SOLUTIONS</div>
          <h1 class="subpage-hero-title">{industry.name}</h1>
          <p class="subpage-hero-lead">
            {industry.tagline}. Delivering integrated mechanical contracting services, precision engineering execution, and certified industrial products across the UAE and Middle East.
          </p>
          <div class="hero-cta-actions">
            <a href="#industry-rfq" class="btn-orange-solid">
              <span>Request Technical Proposal</span>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </a>
            <a href="/industries" class="btn-white-ghost">
              <span>View All Industries</span>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Industry Overview & Operational Framework -->
    <section class="section-block section-cream">
      <div class="content-frame">
        <div class="overview-two-col-grid">
          <!-- Text Overview -->
          <div class="overview-content-pane">
            <div class="section-kicker">SECTOR PROFILE & DEMANDS</div>
            <h2 class="overview-heading-text">Operational Environment & Technical Requirements</h2>
            <div class="orange-bar"></div>
            <p class="overview-main-p" style="font-size:1.1rem; line-height:1.75; color:var(--navy); font-weight:550;">
              {industry.desc}
            </p>
            <div style="background:var(--white); border-left:4px solid var(--orange); padding:1.25rem 1.5rem; margin-top:1.5rem; border-radius:2px; box-shadow:0 4px 16px rgba(20,43,70,0.04);">
              <h4 style="font-size:0.95rem; font-weight:750; color:var(--navy); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">Operating Realities & Challenges</h4>
              <p style="font-size:0.98rem; line-height:1.65; color:var(--slate); margin:0;">
                {industry.challenges}
              </p>
            </div>
          </div>

          <!-- Quick Sector Highlights Card -->
          <div style="background:var(--white); border:1.5px solid var(--border); padding:clamp(1.75rem, 4vw, 2.5rem); border-radius:2px; box-shadow:0 12px 32px rgba(20,43,70,0.06); display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <span style="font-size:0.85rem; font-weight:750; color:var(--orange); text-transform:uppercase; letter-spacing:0.06em;">SECTOR CAPABILITY SUMMARY</span>
              <h3 style="font-size:1.35rem; font-weight:750; color:var(--navy); margin:0.5rem 0 1.25rem;">Petrastream Value Delivery</h3>
              
              <div style="display:flex; flex-direction:column; gap:1rem; font-size:0.95rem;">
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
                  <span style="color:var(--slate-muted);">Primary Focus:</span>
                  <strong style="color:var(--navy); text-align:right;">Contracting & Supply</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
                  <span style="color:var(--slate-muted);">Operating Region:</span>
                  <strong style="color:var(--navy);">United Arab Emirates (UAE)</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
                  <span style="color:var(--slate-muted);">Contract Model:</span>
                  <strong style="color:var(--navy);">Turnkey / Scope-Package</strong>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--border); padding-bottom:0.75rem;">
                  <span style="color:var(--slate-muted);">Turnaround Ready:</span>
                  <strong style="color:var(--navy);">Fast-Track Mobilization</strong>
                </div>
              </div>
            </div>

            <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--border);">
              <a href="#industry-rfq" class="btn-orange-solid" style="width:100%; justify-content:center; text-align:center;">
                <span>Discuss Sector Scope →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Technical Standards & Compliance Framework -->
    <section class="section-block section-white">
      <div class="content-frame">
        <div style="max-width:850px; margin-bottom:2.5rem;">
          <div class="section-kicker">ENGINEERING COMPLIANCE</div>
          <h2 class="overview-heading-text">Applicable Standards & Inspection Protocols</h2>
          <div class="orange-bar"></div>
          <p class="overview-main-p" style="color:var(--slate-muted);">
            All industrial services, piping installations, structural fabrications, and mechanical products supplied for the {industry.name} comply with rigorous international codes and client specifications.
          </p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:1.25rem;">
          {industry.technicalStandards.map((std) => (
            <div style="background:var(--cream); border:1px solid var(--border); padding:1.25rem 1.5rem; border-radius:2px; display:flex; align-items:flex-start; gap:0.85rem;">
              <div style="width:28px; height:28px; background:var(--navy); color:var(--orange); display:flex; align-items:center; justify-content:center; border-radius:2px; flex-shrink:0; margin-top:2px;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span style="font-size:0.95rem; font-weight:650; color:var(--navy); line-height:1.5;">
                {std}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 4: Relevant Mechanical Contracting Services -->
    <section class="section-block section-cream">
      <div class="content-frame">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1.5rem; margin-bottom:2.5rem;">
          <div>
            <div class="section-kicker">CONTRACTING SERVICES</div>
            <h2 class="overview-heading-text">Specialized Services for {industry.name}</h2>
            <div class="orange-bar"></div>
            <p class="overview-main-p" style="color:var(--slate-muted); margin-bottom:0;">
              Execution disciplines mobilized to support maintenance, outages, and construction projects in this sector.
            </p>
          </div>
          <a href="/services" class="btn-navy-outline" style="padding:0.65rem 1.25rem; font-size:0.92rem;">
            <span>View All Services →</span>
          </a>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1.25rem;">
          {industry.services.map((srv) => (
            <a 
              href={`/services/${srv.slug}`}
              style="background:var(--white); border:1.5px solid var(--border); padding:1.5rem; border-radius:2px; text-decoration:none; display:flex; flex-direction:column; justify-content:space-between; gap:1.25rem; transition:all 0.2s ease; box-shadow:0 4px 16px rgba(20,43,70,0.04);"
              class="industry-service-card"
            >
              <div>
                <div style="width:36px; height:36px; background:var(--cream); color:var(--orange); display:flex; align-items:center; justify-content:center; border-radius:2px; margin-bottom:0.9rem;">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 style="font-size:1.15rem; font-weight:750; color:var(--navy); line-height:1.35; margin:0 0 0.5rem;">
                  {srv.name}
                </h3>
                <span style="font-size:0.85rem; color:var(--slate-muted); line-height:1.4; display:block;">
                  Certified mechanical contracting discipline
                </span>
              </div>
              <span style="font-size:0.9rem; font-weight:700; color:var(--orange); display:flex; align-items:center; gap:0.4rem;">
                <span>View Discipline Scope</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 5: Relevant Industrial Products & Equipment -->
    <section class="section-block section-white">
      <div class="content-frame">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1.5rem; margin-bottom:2.5rem;">
          <div>
            <div class="section-kicker">PRODUCTS & EQUIPMENT</div>
            <h2 class="overview-heading-text">Certified Products for {industry.name}</h2>
            <div class="orange-bar"></div>
            <p class="overview-main-p" style="color:var(--slate-muted); margin-bottom:0;">
              Certified valves, specialized tooling, instrumentation, and modular units configured for this sector.
            </p>
          </div>
          <a href="/products" class="btn-navy-outline" style="padding:0.65rem 1.25rem; font-size:0.92rem;">
            <span>View All Products →</span>
          </a>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1.25rem;">
          {industry.products.map((prod) => (
            <a 
              href={`/products/${prod.slug}`}
              style="background:var(--cream); border:1.5px solid var(--border); padding:1.5rem; border-radius:2px; text-decoration:none; display:flex; flex-direction:column; justify-content:space-between; gap:1.25rem; transition:all 0.2s ease;"
              class="industry-product-card"
            >
              <div>
                <div style="width:36px; height:36px; background:var(--navy); color:var(--orange); display:flex; align-items:center; justify-content:center; border-radius:2px; margin-bottom:0.9rem;">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <h3 style="font-size:1.15rem; font-weight:750; color:var(--navy); line-height:1.35; margin:0 0 0.5rem;">
                  {prod.name}
                </h3>
                <span style="font-size:0.85rem; color:var(--slate-muted); line-height:1.4; display:block;">
                  Certified industrial equipment solution
                </span>
              </div>
              <span style="font-size:0.9rem; font-weight:700; color:var(--orange); display:flex; align-items:center; gap:0.4rem;">
                <span>View Product Specs</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 6: Typical Industry Facility Applications -->
    <section class="section-block section-cream">
      <div class="content-frame">
        <div style="max-width:850px; margin-bottom:2.5rem;">
          <div class="section-kicker">SITE APPLICATIONS</div>
          <h2 class="overview-heading-text">Typical Facility Scopes & Site Interventions</h2>
          <div class="orange-bar"></div>
          <p class="overview-main-p" style="color:var(--slate-muted);">
            Proven field activities delivered across processing units, pipeline networks, utility stations, and operational sites.
          </p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1rem;">
          {industry.applications.map((app) => (
            <div style="background:var(--white); border:1px solid var(--border); padding:1.25rem 1.5rem; border-radius:2px; display:flex; align-items:flex-start; gap:0.9rem;">
              <span style="color:var(--orange); font-size:1.4rem; font-weight:800; line-height:1; margin-top:2px;">•</span>
              <p style="font-size:0.98rem; line-height:1.6; color:var(--slate); margin:0;">
                {app}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 7: All 6 Industries Navigator (Cross-Industry Switcher) -->
    <section class="section-block section-white" style="border-bottom:1px solid var(--border);">
      <div class="content-frame">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1.5rem; margin-bottom:2rem;">
          <div>
            <div class="section-kicker">INDUSTRIES DIRECTORY</div>
            <h2 style="font-family:'Manrope',sans-serif; font-size:clamp(1.5rem, 2.2vw, 2rem); font-weight:750; color:var(--navy); margin:0.35rem 0 0;">
              Explore All Supported Industry Sectors
            </h2>
          </div>
          <a href="/industries" class="btn-navy-outline" style="padding:0.65rem 1.25rem; font-size:0.92rem;">
            <span>Browse Full Industries Overview →</span>
          </a>
        </div>

        <!-- 6 Industries Grid -->
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:1rem; margin-bottom:2.5rem;">
          {industriesData.map((item) => {
            const isCurrent = item.slug === industry.slug;
            return (
              <a 
                href={`/industries/${item.slug}`} 
                style={`display:flex; align-items:center; gap:1rem; padding:1.15rem 1.25rem; border-radius:2px; text-decoration:none; transition:all 0.2s ease; border:1.5px solid ${isCurrent ? 'var(--orange)' : 'var(--border)'}; background:${isCurrent ? 'rgba(233,130,53,0.08)' : 'var(--white)'}; box-shadow:${isCurrent ? '0 4px 14px rgba(233,130,53,0.15)' : 'none'};`}
              >
                <div style={`width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:2px; flex-shrink:0; background:${isCurrent ? 'var(--orange)' : 'var(--navy)'}; color:${isCurrent ? 'var(--white)' : 'var(--cream)'};`}>
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <div style="flex:1; min-width:0;">
                  <span style={`display:block; font-size:0.98rem; font-weight:700; line-height:1.35; color:${isCurrent ? 'var(--orange)' : 'var(--navy)'};`}>
                    {item.name}
                  </span>
                  {isCurrent && (
                    <span style="display:inline-block; font-size:0.72rem; font-weight:750; color:var(--orange); text-transform:uppercase; letter-spacing:0.05em; margin-top:0.2rem;">
                      ● Currently Viewing
                    </span>
                  )}
                </div>
                <svg width="16" height="16" fill="none" stroke={isCurrent ? "var(--orange)" : "var(--slate-muted)"} stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
              </a>
            );
          })}
        </div>

        <!-- Previous / Next Pagination Row -->
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.25rem; padding-top:1.5rem; border-top:1px solid var(--border);">
          <a href={`/industries/${prevIndustry.slug}`} class="btn-navy-outline" style="padding:0.75rem 1.35rem; font-size:0.92rem;">
            <span>← Previous: {prevIndustry.name}</span>
          </a>
          <a href={`/industries/${nextIndustry.slug}`} class="btn-orange-solid" style="padding:0.75rem 1.35rem; font-size:0.92rem;">
            <span>Next: {nextIndustry.name} →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Section 8: Dedicated On-Page RFQ Consultation Form -->
    <section class="section-block section-cream" id="industry-rfq">
      <div class="content-frame">
        <div class="contact-two-col-grid">
          <div class="contact-info-column">
            <div class="section-label-chip">
              <span class="label-dot"></span>
              <span>TECHNICAL CONSULTATION</span>
            </div>
            <h2 class="section-h2" style="margin-top:0.75rem;">Discuss Your {industry.name} Requirements</h2>
            <p class="section-lead-p" style="margin-bottom:2rem;">
              Connect directly with Petrastream's technical coordination desk in the UAE. Provide your facility parameters, work-pack specifications, scheduled turnaround timeline, or equipment procurement details.
            </p>
            <div class="contact-meta-card">
              <div class="contact-icon-box">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <span class="contact-meta-label">Technical RFQ Submissions</span>
                <p class="contact-meta-val"><a href="mailto:info@petra-stream.com" class="contact-meta-link">info@petra-stream.com</a></p>
              </div>
            </div>
            <div class="contact-meta-card" style="margin-top:1rem;">
              <div class="contact-icon-box">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <span class="contact-meta-label">Technical Review Standard</span>
                <p class="contact-meta-val">Rapid review and proposal feedback within 24 business hours</p>
              </div>
            </div>
          </div>

          <div class="contact-form-column">
            <div class="form-container-card">
              <h3 class="form-card-title">Submit {industry.name} Enquiry</h3>
              <p class="form-card-subtitle">Complete the parameters below to connect with our engineering team.</p>
              
              <form class="actual-form-element" onsubmit="event.preventDefault(); alert('Thank you. Your enquiry for ' + this.elements['industry'].value + ' has been received. Our UAE engineering coordination desk will contact you within 24 business hours.');">
                <div class="form-two-col-fields">
                  <div class="form-field-group">
                    <label class="field-label-bold">Your Full Name *</label>
                    <input type="text" class="input-box" placeholder="e.g. Ahmed Al-Mansoor" required />
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-bold">Company / Organization *</label>
                    <input type="text" class="input-box" placeholder="e.g. EPC Contractor / Operating Co" required />
                  </div>
                </div>

                <div class="form-two-col-fields">
                  <div class="form-field-group">
                    <label class="field-label-bold">Official Business Email *</label>
                    <input type="email" class="input-box" placeholder="name@company.com" required />
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-bold">Direct Phone Number</label>
                    <input type="tel" class="input-box" placeholder="+971 50 000 0000" />
                  </div>
                </div>

                <div class="form-field-group">
                  <label class="field-label-bold">Target Industry Sector</label>
                  <input type="text" name="industry" class="input-box" value={industry.name} readonly style="background:#F3F4F6; cursor:not-allowed;" />
                </div>

                <div class="form-field-group">
                  <label class="field-label-bold">Project Scope & Technical Specifications *</label>
                  <textarea class="input-box" rows="4" placeholder="Please outline the required scope of work, operating facility type, piping/vessel requirements, shutdown timeline, or equipment specifications..." required></textarea>
                </div>

                <button type="submit" class="btn-orange-solid" style="width:100%; justify-content:center; padding:1rem; font-size:1.05rem;">
                  <span>Submit Industry RFQ →</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <Modals />
</Layout>
