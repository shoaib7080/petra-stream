---
// Footer.astro - Section 11: Corporate Industrial Footer
import { siteConfig } from '../config/siteConfig.js';
---

<footer class="site-footer">
  <div class="content-frame">
    <!-- Main Footer Grid (4 Columns) -->
    <div class="footer-columns-grid">
      <!-- Col 1: Brand & Overview -->
      <div class="footer-col-brand">
        <a href="/" class="footer-brand-logo">
          <div class="brand-badge-box">P</div>
          <div class="brand-naming">
            <span class="brand-title-white">PETRASTREAM</span>
            <span class="brand-subline-orange">CONTRACTING LLC</span>
          </div>
        </a>
        <p class="footer-about-text">
          Petra Stream (Petrastream Contracting LLC) is a premier UAE-based Mechanical Service Provider and certified Industrial Products Provider supporting operating companies, EPC contractors, and refineries across the Middle East.
        </p>
        <div class="footer-license-tag">
          <span>Licensed & Operating in the United Arab Emirates</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h4 class="footer-column-heading">Navigation</h4>
        <ul class="footer-links-list">
          <li><a href="/">Home</a></li>
          <li><a href="/about-us">About Petrastream</a></li>
          <li><a href="/services">Contracting Services</a></li>
          <li><a href="/products">Equipment & Products</a></li>
          <li><a href="/industries">Industries We Serve</a></li>
          <li><a href="/contact-us">Contact & RFQ</a></li>
          <li><a href="/#why-choose">Why Choose Us</a></li>
          <li><a href="/#approach">Our 5-Stage Approach</a></li>
          <li><a href="/#faq">FAQ & Guidance</a></li>
        </ul>
      </div>

      <!-- Col 3: Specialized Service Categories (Dedicated Subpages) -->
      <div>
        <h4 class="footer-column-heading">Service Categories</h4>
        <ul class="footer-links-list">
          <li><a href="/services/maintenance-shutdown-turnaround">01. Maintenance & Shutdowns</a></li>
          <li><a href="/services/pre-commissioning-commissioning">02. Pre-Commissioning & Startup</a></li>
          <li><a href="/services/electrical-instrumentation">03. Electrical & Instrumentation</a></li>
          <li><a href="/services/civil-structural-works">04. Civil Foundations & Structures</a></li>
          <li><a href="/services/mechanical-erection">05. Mechanical Equipment Erection</a></li>
          <li><a href="/services/process-plant-piping">06. Process & Plant Piping</a></li>
          <li><a href="/services/pipeline-construction">07. Cross-Country Pipelines</a></li>
          <li><a href="/services/oil-gas-plant-construction">08. Oil & Gas Plant Construction</a></li>
          <li><a href="/services/welding-habitats">09. Pressurized Welding Habitats</a></li>
        </ul>
      </div>

      <!-- Col 4: Products & Direct Inquiries -->
      <div>
        <h4 class="footer-column-heading">Products & Inquiries</h4>
        <ul class="footer-links-list">
          <li><a href="/products/industrial-valves">Valves & Actuators</a></li>
          <li><a href="/products/orifice-flanges-plates">Orifice Plates & Metering</a></li>
          <li><a href="/products/wireless-corrosion-sensors">Wireless Corrosion Sensors</a></li>
          <li><a href="/products/hot-tapping-equipment">Hot Tapping Equipment</a></li>
          <li><a href="/products/industrial-flushing-units">Industrial Flushing Skids</a></li>
          <li><a href="/products/blast-resistant-buildings-ehouses">Modular Blast-Proof E-Houses</a></li>
        </ul>

        <div class="footer-contact-block" style="margin-top:1.25rem;">
          <div class="footer-contact-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
            <span>United Arab Emirates (UAE)</span>
          </div>
          <div class="footer-contact-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:info@petra-stream.com" style="color:var(--orange); font-weight:700; text-decoration:none;">info@petra-stream.com</a>
          </div>
          <div class="footer-contact-item" style="margin-top:0.25rem;">
            <a href="/contact-us" class="btn-orange-solid" style="padding:0.5rem 1rem; font-size:0.85rem; text-decoration:none; display:inline-flex; width:auto;">
              <span>Submit RFQ Proposal →</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="footer-bottom-strip">
      <div>
        © 2026 Petrastream Contracting LLC. All Rights Reserved.
      </div>
      <div>
        Mechanical Contracting Services & Certified Equipment Solutions • UAE
      </div>
    </div>
  </div>
</footer>
