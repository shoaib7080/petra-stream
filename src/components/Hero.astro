---
// Hero.astro - Full-width industrial hero section with cycling background videos and primary color gradient overlay
import { imageConfig } from '../config/imageConfig.js';
---

<section class="hero-industrial-bold" id="hero">
  <!-- Background Media: 2 cycling industrial 4K videos with fallback poster image -->
  <div class="hero-media-wrapper" aria-hidden="true">
    <div class="hero-oilgas-img" style={`background-image: url('${imageConfig.heroImage.url}');`} role="img" aria-label={imageConfig.heroImage.alt}></div>
    
    <video
      id="hero-video-1"
      class="hero-bg-video is-active"
      autoplay
      muted
      playsinline
      preload="metadata"
    >
      <source src="/assets/vids/10386901-hd_3840_2160_30fps.mp4" type="video/mp4" />
    </video>

    <video
      id="hero-video-2"
      class="hero-bg-video"
      muted
      playsinline
      preload="metadata"
    >
      <source src="/assets/vids/12891229-uhd_3840_2160_30fps.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Primary Colour Gradient Overlay: Denser on left for text readability, transitioning so video is more visible on the right -->
  <div class="hero-scrim-dark"></div>
  <div class="hero-scrim-vignette"></div>

  <div class="content-frame">
    <div class="hero-text-container" style="max-width: 980px;">
      <div class="section-kicker section-kicker-light">
        INDUSTRIAL CONTRACTING | ENGINEERING | SPECIALIZED PRODUCTS
      </div>
      <h1 class="hero-super-title">
        Industrial Contracting & <span class="highlight-orange">Specialized Solutions</span> for Critical Industries
      </h1>
      <p class="hero-sub-description">
        Delivering industrial services and specialized product solutions to support the evolving requirements of the Oil & Gas, Energy and Industrial sectors.
      </p>
      <div class="hero-cta-actions">
        <a href="/services" class="btn-orange-solid">
          <span>Explore Our Services</span>
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <a href="/products" class="btn-white-ghost">
          <span>Explore Our Products</span>
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initHeroCyclingVideos() {
    const v1 = document.getElementById('hero-video-1');
    const v2 = document.getElementById('hero-video-2');
    if (!v1 || !v2) return;

    let activeVideo = v1;
    let nextVideo = v2;
    let isTransitioning = false;

    v1.muted = true;
    v2.muted = true;

    function safePlay(v) {
      if (!v) return;
      v.muted = true;
      const p = v.play();
      if (p !== undefined) {
        p.catch(() => {});
      }
    }

    function transitionToNext() {
      if (isTransitioning) return;
      isTransitioning = true;

      nextVideo.currentTime = 0;
      nextVideo.muted = true;
      const playPromise = nextVideo.play();

      const performSwitch = () => {
        nextVideo.classList.add('is-active');
        activeVideo.classList.remove('is-active');

        setTimeout(() => {
          activeVideo.pause();
          activeVideo.currentTime = 0;
          const temp = activeVideo;
          activeVideo = nextVideo;
          nextVideo = temp;
          isTransitioning = false;
        }, 1200);
      };

      if (playPromise !== undefined) {
        playPromise.then(performSwitch).catch(() => {
          isTransitioning = false;
          safePlay(activeVideo);
        });
      } else {
        performSwitch();
      }
    }

    function checkVideoProgress(e) {
      const vid = e.target;
      if (vid === activeVideo && vid.duration && (vid.duration - vid.currentTime <= 1.2)) {
        transitionToNext();
      }
    }

    v1.addEventListener('timeupdate', checkVideoProgress);
    v2.addEventListener('timeupdate', checkVideoProgress);
    v1.addEventListener('ended', transitionToNext);
    v2.addEventListener('ended', transitionToNext);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && activeVideo) {
        safePlay(activeVideo);
      }
    });

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v1.pause();
      v2.pause();
      return;
    }

    safePlay(activeVideo);
  })();
</script>
