---
// Products.astro - Section 06: Specialized Industrial Products & Equipment (Catalogue Carousel Style - 2 Rows)
const products = [
  { name: "Hot Tapping Equipment", slug: "hot-tapping-equipment", category: "Pipeline & Flow", img: "/assets/img/products/hot-tapping.webp", desc: "Live pipeline connection solutions without shutdown." },
  { name: "Industrial Flushing Units", slug: "industrial-flushing-units", category: "Maintenance Skids", img: "/assets/img/products/flushing-unit.png", desc: "High-velocity lubrication and hydraulic flushing packages." },
  { name: "Hydro Jetting Equipment", slug: "hydro-jetting-equipment", category: "Cleaning Systems", img: "/assets/img/products/Hydrojetting.webp", desc: "High-pressure 500 to 1400+ bar surface cleaning systems." },
  { name: "Industrial Valves", slug: "industrial-valves", category: "Flow Control", img: "/assets/img/products/valves-1.jpg", desc: "Gate, Globe, Ball, Check & Control valves to ASME/API." },
  { name: "Orifice Flanges", slug: "orifice-flanges-plates", category: "Piping Components", img: "/assets/img/products/orifice-flanges.png", desc: "Differential-pressure flow measurement assemblies." },
  { name: "Flow Transmitters", slug: "flow-transmitters", category: "Instrumentation", img: "/assets/img/products/flow-transmitter.jpg", desc: "Electromagnetic, Coriolis and ultrasonic flow measurement." },
  { name: "Wireless Corrosion Sensors", slug: "wireless-corrosion-sensors", category: "Monitoring", img: "/assets/img/products/corrosion-monitoring.jpg", desc: "Non-intrusive asset metal-loss monitoring probes." },
  { name: "Fire Tarpaulins", slug: "fire-tarpaulin-welding-blankets", category: "Safety Solutions", img: "/assets/img/products/Welding-Fire-Blanket.webp", desc: "Certified silica and fiberglass hot-work spark blankets." },
  { name: "Flange Management & Bolting Tools", slug: "flange-management-bolting-tools", category: "Bolting", img: "/assets/img/products/flange-management-2.jpg", desc: "Hydraulic torque wrenches and bolt tensioning packages." },
  { name: "HVAC Systems", slug: "hvac-systems-equipment", category: "Climate Control", img: "/assets/img/products/industrial-hvac-system.jpg", desc: "Explosion-proof air handling and industrial chillers." },
  { name: "Pressurised Habitats", slug: "pressurised-welding-habitat", category: "Safety Enclosures", img: "/assets/img/products/welding-habitat.jpg", desc: "Positive-pressure hot-work enclosures with auto-shutdown." },
  { name: "TGR / Blast-Proof / E-House", slug: "blast-resistant-buildings-ehouses", category: "Modular Buildings", img: "/assets/img/products/tgr-1.jpg", desc: "Engineered blast-resistant electrical substations." },
  { name: "Specialized Containers & Accommodation", slug: "specialized-containers-accommodation", category: "Containers", img: "/assets/img/products/containers-1.jpg", desc: "DNV 2.7-1 certified offshore containers & living modules." },
  { name: "COSASCO Fittings", slug: "cosasco-fittings-accessories", category: "Corrosion Fittings", img: "/assets/img/products/cosasco-1.jpg", desc: "High-pressure mechanical access fittings and probes." },
  { name: "RO & STP Water Treatment", slug: "ro-stp-water-treatment", category: "Water Treatment", img: "/assets/img/products/ro-1.jpg", desc: "Containerized Reverse Osmosis and sewage treatment packages." },
  { name: "Robotics Solutions", slug: "robotics-solutions", category: "Industrial Robotics", img: "/assets/img/products/robotics-1.png", desc: "Pipeline crawlers and remote CCTV inspection systems." },
  { name: "Industrial Automation", slug: "industrial-automation-solutions", category: "Automation & SCADA", img: "/assets/img/products/industrial-automation-1.jpg", desc: "PLC control panels and SCADA integration solutions." }
];

// Split the 17 products evenly into two rows (9 in row 1, 8 in row 2)
const halfIndex = Math.ceil(products.length / 2);
const row1Products = products.slice(0, halfIndex);
const row2Products = products.slice(halfIndex);
---

<section class="section-block section-white catalogue-carousel-section" id="products">
  <div class="content-frame">
    <!-- Centered Section Title per template style -->
    <div class="section-title text-center mb-4" style="text-align: center; max-width: 820px; margin: 0 auto 2.5rem auto;">
      <div class="section-kicker" style="justify-content: center;">OUR PRODUCT PORTFOLIO</div>
      <h2 class="section-heading-lg" style="margin-bottom: 0.65rem;">Specialized Industrial Products & Equipment</h2>
      <p class="section-desc-readable" style="margin: 0 auto; color: var(--slate);">
        Most requested industrial products and fast-moving engineering supplies across critical operating sectors.
      </p>
    </div>

    <!-- Two-Row Catalogue Carousel Wrapper -->
    <div class="catalogue-carousel-wrapper">
      <div class="products-two-rows-container">
        <!-- ROW 1: Process, Pipeline, Instrumentation & Tooling (1–9) -->
        <div class="catalogue-row-wrapper">
          <div class="products-row-label">
            <span class="row-label-dot"></span>
            <span>Pipeline, Valves, Instrumentation & Tooling (1–9)</span>
          </div>

          <div class="catalogue-swiper-outer position-relative">
            <div class="catalogue-scroll-track" id="catalogue-track-1" tabindex="0" role="region" aria-label="Products track 1">
              {row1Products.map((item) => (
                <div class="catalogue-slide-item">
                  <a href={`/products/${item.slug}`} class="catalogue-card-link">
                    <div class="catalogue-item-card">
                      <div class="item-img-box">
                        <img
                          src={item.img}
                          alt={item.name}
                          class="img-fluid"
                          width="420"
                          height="228"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="item-info">
                        <span class="item-category-tag">{item.category}</span>
                        <h4 class="item-title" title={item.name}>{item.name}</h4>
                        <p class="item-desc">{item.desc}</p>
                        <div class="item-action">
                          <span class="item-link">
                            View Details <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                          </span>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              ))}
            </div>

            <!-- Navigation Buttons centered strictly on the card row -->
            <button type="button" class="catalogue-nav-btn catalogue-prev" aria-label="Previous items">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button type="button" class="catalogue-nav-btn catalogue-next" aria-label="Next items">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Pagination directly beneath cards -->
          <div class="catalogue-pagination text-center" role="tablist" aria-label="Pipeline, Valves, Instrumentation & Tooling pagination">
            {row1Products.map((item, idx) => (
              <button
                type="button"
                class={`catalogue-dot ${idx === 0 ? 'active' : ''}`}
                aria-label={`Go to slide ${idx + 1}: ${item.name}`}
                aria-selected={idx === 0 ? "true" : "false"}
                role="tab"
                data-index={idx}
              ></button>
            ))}
          </div>
        </div>

        <!-- ROW 2: Modular Systems, Safety Habitats, Water & Automation (10–17) -->
        <div class="catalogue-row-wrapper">
          <div class="products-row-label">
            <span class="row-label-dot"></span>
            <span>Modular Buildings, Habitats, Water & Automation (10–17)</span>
          </div>

          <div class="catalogue-swiper-outer position-relative">
            <div class="catalogue-scroll-track" id="catalogue-track-2" tabindex="0" role="region" aria-label="Products track 2">
              {row2Products.map((item) => (
                <div class="catalogue-slide-item">
                  <a href={`/products/${item.slug}`} class="catalogue-card-link">
                    <div class="catalogue-item-card">
                      <div class="item-img-box">
                        <img
                          src={item.img}
                          alt={item.name}
                          class="img-fluid"
                          width="420"
                          height="228"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="item-info">
                        <span class="item-category-tag">{item.category}</span>
                        <h4 class="item-title" title={item.name}>{item.name}</h4>
                        <p class="item-desc">{item.desc}</p>
                        <div class="item-action">
                          <span class="item-link">
                            View Details <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                          </span>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              ))}
            </div>

            <!-- Navigation Buttons centered strictly on the card row -->
            <button type="button" class="catalogue-nav-btn catalogue-prev" aria-label="Previous items">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button type="button" class="catalogue-nav-btn catalogue-next" aria-label="Next items">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Pagination directly beneath cards -->
          <div class="catalogue-pagination text-center" role="tablist" aria-label="Modular Buildings, Habitats, Water & Automation pagination">
            {row2Products.map((item, idx) => (
              <button
                type="button"
                class={`catalogue-dot ${idx === 0 ? 'active' : ''}`}
                aria-label={`Go to slide ${idx + 1}: ${item.name}`}
                aria-selected={idx === 0 ? "true" : "false"}
                role="tab"
                data-index={idx}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Button to Full Catalogue -->
    <div style="text-align:center; margin-top:3rem;">
      <a href="/products" class="btn-navy-outline">
        <span>View Full Product Catalogue →</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function initCatalogueCarousel() {
    const outers = document.querySelectorAll('.catalogue-swiper-outer');
    if (!outers.length) return;

    outers.forEach((outer) => {
      const track = outer.querySelector('.catalogue-scroll-track');
      const btnPrev = outer.querySelector('.catalogue-prev');
      const btnNext = outer.querySelector('.catalogue-next');

      if (!track || !btnPrev || !btnNext) return;
      if (track.dataset.scrollerInitialized === 'true') return;
      track.dataset.scrollerInitialized = 'true';

      const rowWrapper = outer.closest('.catalogue-row-wrapper') || outer.parentElement;
      const pagination = rowWrapper ? rowWrapper.querySelector('.catalogue-pagination') : null;
      const items = Array.from(track.querySelectorAll('.catalogue-slide-item'));
      let dots = pagination ? Array.from(pagination.querySelectorAll('.catalogue-dot')) : [];

      function getCardStep() {
        const item = items[0];
        return item ? item.offsetWidth + 24 : 340;
      }

      function updateActiveStates() {
        const scrollLeft = track.scrollLeft;
        const maxScroll = track.scrollWidth - track.clientWidth;

        // Button states
        const isStart = scrollLeft <= 10;
        const isEnd = maxScroll <= 0 || scrollLeft >= maxScroll - 15;

        btnPrev.disabled = isStart;
        btnPrev.classList.toggle('is-disabled', isStart);

        btnNext.disabled = isEnd;
        btnNext.classList.toggle('is-disabled', isEnd);

        // Pagination dots state
        if (dots.length && items.length) {
          let activeIndex = 0;
          if (maxScroll > 0 && scrollLeft >= maxScroll - 20) {
            activeIndex = items.length - 1;
          } else {
            let minDistance = Infinity;
            items.forEach((item, idx) => {
              const itemLeft = item.offsetLeft - track.offsetLeft;
              const distance = Math.abs(itemLeft - scrollLeft);
              if (distance < minDistance) {
                minDistance = distance;
                activeIndex = idx;
              }
            });
          }

          dots.forEach((dot, idx) => {
            const isActive = idx === activeIndex;
            dot.classList.toggle('active', isActive);
            dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
        }
      }

      // Dot click navigation
      if (dots.length) {
        dots.forEach((dot, idx) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            if (items[idx]) {
              const targetLeft = items[idx].offsetLeft - track.offsetLeft;
              track.scrollTo({ left: targetLeft, behavior: 'smooth' });
              setTimeout(updateActiveStates, 320);
            }
          });
        });
      }

      btnNext.addEventListener('click', (e) => {
        e.preventDefault();
        const step = getCardStep();
        track.scrollBy({ left: step, behavior: 'smooth' });
        setTimeout(updateActiveStates, 320);
      });

      btnPrev.addEventListener('click', (e) => {
        e.preventDefault();
        const step = getCardStep();
        track.scrollBy({ left: -step, behavior: 'smooth' });
        setTimeout(updateActiveStates, 320);
      });

      track.addEventListener('scroll', updateActiveStates, { passive: true });

      // Smooth mouse drag-to-scroll on desktop
      let isDown = false;
      let startX;
      let scrollLeft;
      let moved = false;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        moved = false;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mouseup', () => {
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.35;
        if (Math.abs(walk) > 4) moved = true;
        track.scrollLeft = scrollLeft - walk;
      });

      track.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      updateActiveStates();
    });
  })();
</script>
