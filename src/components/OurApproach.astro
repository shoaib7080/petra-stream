---
// OurApproach.astro - Section 09: Our Approach per blueprint
const steps = [
  {
    step: "01",
    phase: "DISCOVERY",
    title: "Understanding Your Requirements",
    desc: "We review the enquiry, project scope, technical specifications and required deliverables."
  },
  {
    step: "02",
    phase: "EVALUATION",
    title: "Technical Review & Evaluation",
    desc: "We assess the relevant technical requirements and identify suitable solutions."
  },
  {
    step: "03",
    phase: "PROPOSAL",
    title: "Proposal & Coordination",
    desc: "We coordinate the relevant technical and commercial information for the proposed scope."
  },
  {
    step: "04",
    phase: "EXECUTION",
    title: "Service Execution or Product Supply",
    desc: "We proceed according to the mutually agreed scope, specifications and commercial terms."
  },
  {
    step: "05",
    phase: "HANDOVER",
    title: "Completion & Handover",
    desc: "We coordinate applicable documentation and agreed handover requirements."
  }
];
---

<section class="section-block theme-light" id="approach">
  <div class="content-frame">
    <!-- Header Block -->
    <div class="section-title-wrap">
      <div class="section-label-chip">
        <!-- <span class="label-dot"></span> -->
        <span>HOW WE WORK</span>
      </div>
      <h2 class="section-h2">From Understanding Requirements to Delivering Solutions</h2>
      <p class="section-lead-p">
        We follow a structured approach to understand client requirements, evaluate the scope and coordinate suitable service or product solutions.
      </p>
    </div>

    <!-- Timeline Wrapper (Horizontal Desktop, Vertical Mobile) -->
    <div class="timeline-container">
      <div class="timeline-row">
        {steps.map((item, idx) => (
          <div class="timeline-step">
            <div class="timeline-marker">
              <span class="timeline-step-num">{item.step}</span>
              {idx < steps.length - 1 && <div class="timeline-connector-line"></div>}
            </div>
            <div class="timeline-card">
              <span class="timeline-phase-tag">{item.phase}</span>
              <h3 class="timeline-title">{item.title}</h3>
              <p class="timeline-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
